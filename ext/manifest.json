{
  "manifest_version": 3,
  "name": "Fude: paint your music",
  "short_name": "Fude",
  "version": "1.0.4",
  "description": "Fude paints the music playing in your browser, song by song, in the side panel: Spotify, YouTube and more.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Paint this music with Fude",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "tabCapture",
    "activeTab",
    "scripting",
    "identity",
    "storage"
  ],
  "optional_permissions": [
    "desktopCapture"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Paint the music in this tab"
    }
  },
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://music.apple.com/*",
    "https://soundcloud.com/*",
    "https://www.deezer.com/*",
    "https://listen.tidal.com/*",
    "https://*.bandcamp.com/*",
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*"
  ],
  "minimum_chrome_version": "116"
}